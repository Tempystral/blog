---
import { imageCache } from "@/data/media";
import type { ImageMetadata } from "astro";
import path from "path";

interface Props {
	src: string;
	captions: Record<string, string>;
}
const { src, captions } = Astro.props;

const images = await getImages(src);

function getAbsPath(p: string) {
	const slug = Astro.url.pathname.split("/")[2] ?? "";
	return path.resolve("/src/content/post/", slug, p);
}

async function getImages(dir: string) {
	const p = getAbsPath(dir);

	const metadata: ImageMetadata[] = [];
	for await (const [name, data] of Object.entries(imageCache)) {
		if (name.startsWith(p)) {
			const meta = (await data()).default;
			metadata.push(meta);
		}
	}
	return metadata;
}

function getCaption(img: ImageMetadata) {
	const key = getFilename(img);
	console.log(key);
	if (captions && key in captions) return captions[key];
	else return undefined;
}

function getFilename(img: ImageMetadata) {
	return img.src.substring(img.src.lastIndexOf("/") + 1, img.src.indexOf("."));
	// return img.src.split(/\/|\?/g).at(-2) ?? "";
}

// https://css-tricks.com/adaptive-photo-layout-with-flexbox/
---

<figure class="static flex flex-wrap gap-1 rounded-md bg-accent-2 p-2 dark:bg-quote">
	{
		images.map((img) => (
			<a href={img.src} class="not-prose relative h-[30vh] flex-grow transition-transform">
				<img
					src={img.src}
					alt={""}
					class="not-prose max-h-full min-w-full rounded-sm object-cover align-bottom"
				/>
				{getCaption(img) != undefined && (
					<div class="absolute bottom-0 left-0 h-full w-full opacity-0 transition-opacity hover:opacity-100">
						<figcaption class="absolute bottom-0 flex w-full flex-col justify-center rounded-sm bg-accent-2 px-2 dark:bg-textColor">
							<p class="text-center">{getCaption(img)}</p>
						</figcaption>
					</div>
				)}
			</a>
		))
	}
</figure>
